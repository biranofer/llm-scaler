load:
  type: constant
  stages:
  - rate: 5
    duration: 300
  - rate: 10
    duration: 300
  - rate: 15
    duration: 300
  request_timeout: 300
api:
  type: completion
  streaming: true
server:
  type: vllm
  model_name: REPLACE_ENV_LLMDBENCH_DEPLOY_CURRENT_MODEL
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  pretrained_model_name_or_path: REPLACE_ENV_LLMDBENCH_DEPLOY_CURRENT_MODEL
data:
  type: shareGPT
  input_distribution:
    min: 10
    max: 2048
  output_distribution:
    min: 10
    max: 1024
report:
  request_lifecycle:
    summary: true
    per_stage: true
    # false: nothing we have reads the per-request dump, and it is what turns a
    # finished run into a failed one. It embeds every prompt and streamed response,
    # so an external evaluation of this stack produced a 4.8 GiB file in a 5.1 GiB
    # result directory, and the single `kubectl cp` collecting it died near the end
    # with `websocket: close 1006` -- the runner then marked the treatment failed
    # and deleted the harness pod, after the load and the reports had both
    # succeeded. Their compact controls transferred 55 MiB in about three seconds.
    #
    # postprocess.py reads results.json, replica_status_timeseries.json,
    # pod_startup_times.json and wva_pod_timings.json; the TTFT percentiles and
    # GPU-hours come from summary_lifecycle_metrics.json and the per-stage files.
    # None of them is this one. Turn it back on deliberately, for one run, if you
    # ever need to inspect individual requests.
    per_request: false
storage:
  local_storage:
    path: /workspace
