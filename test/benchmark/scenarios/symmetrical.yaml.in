metadata:
  labels:
    name: symmetrical
    description: |
      Balanced workload with equal input and output token lengths.
spec:
  backend:
    kind: openai_http
    target: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
    model: REPLACE_ENV_LLMDBENCH_DEPLOY_CURRENT_MODEL
    request_format: /v1/completions
  profile:
    kind: poisson
    rate: 20
  data:
  - kind: synthetic_text
    prompt_tokens: 1000
    output_tokens: 1000
  constraints:
  - kind: max_duration
    seconds: 600
