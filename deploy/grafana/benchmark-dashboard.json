{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Deployment Replicas",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "wva_desired_replicas{$namespace_label=~\"$namespace\"}",
          "legendFormat": "desired {{variant_name}}",
          "refId": "A"
        },
        {
          "expr": "wva_current_replicas{$namespace_label=~\"$namespace\"}",
          "legendFormat": "current {{variant_name}}",
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "WVA Desired Ratio",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "wva_desired_ratio{$namespace_label=~\"$namespace\"}",
          "legendFormat": "ratio {{variant_name}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "KV Cache Usage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "spanNulls": true
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (pod) (vllm:kv_cache_usage_perc{$namespace_label=~\"$namespace\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        },
        {
          "expr": "avg(max by (pod) (vllm:kv_cache_usage_perc{$namespace_label=~\"$namespace\"}))",
          "legendFormat": "avg",
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Engine Queue and Running Requests (per pod)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (pod) (vllm:num_requests_waiting{$namespace_label=~\"$namespace\"})",
          "legendFormat": "{{pod}} waiting",
          "refId": "A"
        },
        {
          "expr": "max by (pod) (vllm:num_requests_running{$namespace_label=~\"$namespace\"})",
          "legendFormat": "{{pod}} running",
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Per-pod engine state. 'waiting' is vllm:num_requests_waiting -- the queue INSIDE the engine. With EPP flow control enabled this normally reads 0 even under heavy load, because flow control holds the backlog at the router instead; see the EPP Flow-Control Queue panel.\n\nAggregated with max by (pod) so a pod scraped by two PodMonitors still draws one line per replica."
    },
    {
      "id": 5,
      "title": "Scaling Activity",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "wva_desired_replicas{$namespace_label=~\"$namespace\"}",
          "legendFormat": "desired {{variant_name}}",
          "refId": "A"
        },
        {
          "expr": "wva_current_replicas{$namespace_label=~\"$namespace\"}",
          "legendFormat": "current {{variant_name}}",
          "refId": "B"
        },
        {
          "expr": "rate(wva_replica_scaling_total{$namespace_label=~\"$namespace\"}[2m])",
          "legendFormat": "scaling rate {{variant_name}} {{direction}}",
          "refId": "C"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "EPP Flow-Control Queue (Requests Queued at the Router)",
      "type": "timeseries",
      "description": "Requests held by the EPP's flow-control layer, before they reach an engine.\n\nThis is where a backlog appears when flow control is enabled: it admits only what the engine can absorb, so vllm:num_requests_waiting can sit at 0 while hundreds of requests are queued here. A rising queue with a flat engine queue means demand exceeds decode throughput, not KV capacity.\n\nNot filtered by namespace: these EPP series carry no namespace label (llm-d #2309).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (model_name) (inference_extension_flow_control_queue_size) or sum by (model_name) (llm_d_epp_flow_control_queue_size)",
          "legendFormat": "{{model_name}} queued",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "benchmark",
    "wva",
    "autoscaling"
  ],
  "templating": {
    "list": [
      {
        "name": "namespace_label",
        "label": "Namespace label",
        "type": "custom",
        "query": "namespace,exported_namespace",
        "current": {
          "text": "namespace",
          "value": "namespace"
        },
        "options": [
          {
            "text": "namespace",
            "value": "namespace",
            "selected": true
          },
          {
            "text": "exported_namespace",
            "value": "exported_namespace",
            "selected": false
          }
        ],
        "includeAll": false,
        "multi": false,
        "description": "Which label carries the namespace. vLLM metrics carry only `namespace`. wva_* metrics carry both, and there `exported_namespace` is the WORKLOAD's namespace while `namespace` is the controller's -- the same value for a namespace-scoped install, different for a cluster-scoped one."
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus"
        },
        "query": {
          "query": "label_values(vllm:num_requests_running, $namespace_label)",
          "refId": "namespace-variable-query"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": false,
        "sort": 1,
        "description": "The namespace whose model servers to chart."
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "utc",
  "title": "WVA Benchmark: Scale-Up Latency",
  "uid": "wva-benchmark-scaleup",
  "version": 1
}